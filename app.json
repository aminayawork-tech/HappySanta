{
  "expo": {
    "name": "HappySanta",
    "slug": "happysanta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "happysanta",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.happysanta.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "HappySanta uses the camera to let you add photos for recipients.",
        "NSPhotoLibraryUsageDescription": "HappySanta uses your photo library to let you add photos for recipients.",
        "UIBackgroundModes": ["remote-notification", "fetch"]
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1a0a2e"
      },
      "package": "com.happysanta.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a0a2e"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C41E3A",
          "androidMode": "default",
          "androidCollapsedTitle": "HappySanta 🎅"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HappySanta uses your photos for recipient avatars."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}

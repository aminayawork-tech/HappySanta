# ─────────────────────────────────────────────────────────────
# HappySanta — Environment Variables Example
# Copy this to .env and fill in your real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdefabcdefabcdef
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Sign-In ────────────────────────────────────────────
# Get from Google Cloud Console → OAuth 2.0 → iOS Client ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=XXXXXXXXXX-XXXXXXXXXXXXXXXX.apps.googleusercontent.com
# Android Client ID (from google-services.json)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=XXXXXXXXXX-XXXXXXXXXXXXXXXX.apps.googleusercontent.com
# Web Client ID (for Firebase Auth)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=XXXXXXXXXX-XXXXXXXXXXXXXXXX.apps.googleusercontent.com

# ── AI: OpenAI ────────────────────────────────────────────────
# https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o

# ── AI: Grok (X.AI) — alternative to OpenAI ──────────────────
# https://console.x.ai/
EXPO_PUBLIC_GROK_API_KEY=xai-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_GROK_BASE_URL=https://api.x.ai/v1

# ── Which AI provider to use: "openai" | "grok" ───────────────
EXPO_PUBLIC_AI_PROVIDER=openai

# ── Amazon Creators API ───────────────────────────────────────
# Sign up: https://affiliate-program.amazon.com/creatorsapi/docs/
# Step 1: Join Amazon Associates: https://affiliate-program.amazon.com/
# Step 2: Request Creators API access from the Associates dashboard
# Step 3: Generate API Key from Creators API portal
EXPO_PUBLIC_AMAZON_CREATORS_API_KEY=YOUR_AMAZON_CREATORS_API_KEY
EXPO_PUBLIC_AMAZON_AFFILIATE_TAG=happysanta-20
EXPO_PUBLIC_AMAZON_API_BASE_URL=https://api.creators.amazon.com/v1

# ── Keepa Price History API ───────────────────────────────────
# Sign up: https://keepa.com/#!api
# Pricing: ~$17/month for 7,200 tokens/day (sufficient for MVP)
# Each product history lookup costs ~5 tokens
EXPO_PUBLIC_KEEPA_API_KEY=YOUR_KEEPA_API_KEY_HERE
EXPO_PUBLIC_KEEPA_API_BASE_URL=https://api.keepa.com

# ── App Config ────────────────────────────────────────────────
# Price check interval (milliseconds). Default: 6 hours
EXPO_PUBLIC_PRICE_CHECK_INTERVAL_MS=21600000
# Marketplace: US=1, UK=3, DE=4, FR=5, JP=6, CA=7, etc.
EXPO_PUBLIC_AMAZON_MARKETPLACE_ID=1
